// kuterm dark theme, one dark
//
// created with default values on first launch, edit it to change colors.
// its path is set in settings.jsonc under "theme" -> "dark".
// colors are hex strings: "#rgb", "#rgba", "#rrggbb" or "#rrggbbaa".
// comments and trailing commas are allowed, missing values use colors from this file.
// if this file is invalid, the bundled theme is used and an error is printed.
{
  // tab bar
  "tab_bar_background": "#2f343e",
  "tab_active_background": "#282c33",
  "border": "#464b57",
  "text": "#dce0e5",
  "text_muted": "#a9afbc",

  // buttons that destroy something, like "close" in the dialog asking to close a busy tab
  "danger_button": "#be5046",
  "danger_button_text": "#ffffff",

  // terminal
  "terminal_background": "#282c34",
  "terminal_foreground": "#abb2bf",
  "cursor": "#74ade8",
  "selection": "#3e4451",
  "scrollbar": "#4e5666",
  "bright_foreground": "#dce0e5",
  "dim_foreground": "#636d83",

  // 16 ansi colors, must have exactly 16 entries
  "ansi": [
    // normal: black, red, green, yellow, blue, magenta, cyan, white
    "#282c34", "#e06c75", "#98c379", "#e5c07b", "#61afef", "#c678dd", "#56b6c2", "#abb2bf",
    // bright: black, red, green, yellow, blue, magenta, cyan, white
    "#636d83", "#ea858b", "#aad581", "#ffd885", "#85c1ff", "#d398eb", "#6ed5de", "#fafafa",
  ],
  // dim ansi colors, must have exactly 8 entries
  // black, red, green, yellow, blue, magenta, cyan, white
  "ansi_dim": ["#3b3f4a", "#a7545a", "#6d8f59", "#b8985b", "#457cad", "#8d54a0", "#3c818a", "#8f969b"],
}
