// kuterm tab icons
//
// this file is created with default values on first launch.
// icons of programs in tabs, when "tab_icon.dynamic" is on in settings.

{
  // programs started through these are matched by their script, like "pi" in "node /usr/bin/pi"
  "interpreters": ["node", "nodejs", "bun", "deno", "python", "python3", "ruby", "perl"],
  // programs that run another one, like "htop" in "sudo htop", show the icon of the program they run
  "wrappers": ["sudo", "doas", "run0", "pkexec", "env", "nice", "nohup", "timeout"],
  "groups": [
    {
      // remote shells
      "icon": "",
      "commands": ["ssh", "mosh", "telnet", "sftp", "ftp", "lftp", "scp", "rlogin", "rsh", "autossh", "sshpass"],
    },
    {
      // network tools
      "icon": "",
      "commands": ["ping", "ping6", "traceroute", "tracepath", "mtr", "nmap", "dig", "nslookup", "host", "whois", "netstat", "ss", "tcpdump", "tshark", "iperf", "iperf3", "nc", "ncat", "netcat", "socat", "arp", "iftop", "nethogs", "bandwhich", "nload", "speedtest", "speedtest-cli"],
    },
    {
      // downloads
      "icon": "󰇚",
      "commands": ["curl", "wget", "aria2c", "xh", "http"],
    },
    {
      // ai agents
      "icon": "󰚩",
      "commands": ["claude", "opencode", "pi", "codex", "gemini", "aider", "crush", "goose", "amp", "cursor-agent", "copilot", "qwen", "ollama", "llm", "droid", "kiro-cli"],
    },
    {
      // system monitors
      "icon": "󰨇",
      "commands": ["htop", "btop", "top", "atop", "bpytop", "bashtop", "glances", "nvtop", "iotop", "btm", "gotop", "gtop", "zenith", "s-tui", "bottom"],
    },
    {
      // editors
      "icon": "",
      "commands": ["vi", "vim", "nvim", "nano", "micro", "hx", "helix", "emacs", "kak"],
    },
    {
      // git
      "icon": "",
      "commands": ["git", "lazygit", "tig", "gitui", "gh"],
    },
    {
      // containers
      "icon": "󰡨",
      "commands": ["docker", "podman", "lazydocker", "docker-compose", "podman-compose"],
    },
    {
      // kubernetes
      "icon": "󱃾",
      "commands": ["kubectl", "k9s", "helm", "kubectx", "kubens", "minikube", "kind"],
    },
    {
      // package managers
      "icon": "󰏖",
      "commands": ["apt", "apt-get", "aptitude", "dpkg", "nala", "dnf", "dnf5", "yum", "rpm", "rpm-ostree", "zypper", "pacman", "yay", "paru", "pamac", "apk", "emerge", "xbps-install", "eopkg", "nix", "nix-env", "flatpak", "snap", "brew", "pkg"],
    },
  ],
}
