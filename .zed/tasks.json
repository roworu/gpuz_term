
[
  {
    // build and test inside podman, see Containerfile for the build environment
    "label": "podman: build + test",
    "command": "podman build -q -t gpuz_term-dev - < Containerfile && podman run --rm -v \"$ZED_WORKTREE_ROOT\":/src:Z -v gpuz_term-cargo-registry:/usr/local/cargo/registry -v gpuz_term-cargo-git:/usr/local/cargo/git gpuz_term-dev sh -c 'cargo build && cargo test'",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },

  {
    // run build made by podman
    "label": "run app",
    "command": "./target/podman/debug/gpuz_term",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
